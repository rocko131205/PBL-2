# {{ ansible_managed }}
# Runtime configuration for finveritas.service — mode 0640, readable only by root and the service.
# Secret values come from Ansible Vault: edit group_vars, not this file.
{% for key, value in finveritas_environment | dictsort %}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
{% endfor %}
