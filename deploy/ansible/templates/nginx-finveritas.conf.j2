# {{ ansible_managed }}
# Public entry point: nginx :80 → Streamlit on 127.0.0.1:{{ finveritas_port }} (never exposed directly).
# For HTTPS, point a domain at the server, set finveritas_server_name, then run: certbot --nginx

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ finveritas_server_name }};

    server_tokens off;
    client_max_body_size 25m;   # = maxUploadSize in .streamlit/config.toml

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;   # Streamlit components use same-origin iframes
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:{{ finveritas_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Each Streamlit session runs over a long-lived WebSocket.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}
