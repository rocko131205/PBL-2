# Copy to .env (gitignored) and fill in:  cp .env.example .env

# REQUIRED, >= 32 random chars:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# REQUIRED: Grafana "admin" password (dashboards are viewable without logging in)
GRAFANA_ADMIN_PASSWORD=

# Synthetic users (docker compose --profile load up -d). The password must meet the app's
# policy: 8+ chars with upper and lower case, a digit and a special character.
SYNTHETIC_EMAIL=synthetic@finveritas.local
SYNTHETIC_PASSWORD=

# Version label shown in the app footer and on the dashboard
APP_VERSION=dev
