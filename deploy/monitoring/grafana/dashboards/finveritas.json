    {
      "type": "timeseries",
      "title": "Page renders per second by page",
      "description": "Which screens users are working in.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (page) (rate(finveritas_page_renders_total[$__rate_interval]))",
          "legendFormat": "{{page}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
