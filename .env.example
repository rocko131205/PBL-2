# Copy to .env and fill in. Never commit .env.

# REQUIRED — random, >= 32 chars:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Optional separate key for encrypting MFA secrets at rest (defaults to a key derived from JWT_SECRET)
FIELD_ENCRYPTION_KEY=

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGO_DB_NAME=finveritas

# Email OTP for password reset (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# LLM — any OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=

NEWSAPI_KEY=
FMP_API_KEY=
# Optional: second provider for filling missing fields on ticker data
ALPHA_VANTAGE_API_KEY=

# Number of trusted reverse proxies in front of the API (1 on Render). 0 = ignore X-Forwarded-For,
# so client IPs in the audit log can't be forged.
TRUST_PROXY_HOPS=0
